-- [[ Main Engine & Loops ]] --

-- Hooking Engine สำหรับ Silent Aim
local meta = getrawmetatable(game)
local oldNamecall = meta.__namecall
setreadonly(meta, false)

meta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if SilentAimEnabled and (method == "FindPartOnRayWithIgnoreList" or method == "Raycast" or method == "FindPartOnRay") then
        local target = GetClosestPlayerToCursor()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            return target.Character.Head
        end
    end
    return oldNamecall(self, ...)
end)

setreadonly(meta, true)

-- ESP & FOV Render Loop
RunService.RenderStepped:Connect(function()
   -- อัปเดตตำแหน่งวงกลม FOV ให้อยู่กลางจอเสมอ
   FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

   -- อัปเดตตำแหน่ง ESP
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 and player.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = player.Character.HumanoidRootPart
         local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

         -- Box ESP
         if ESP_Box_Enabled and onScreen then
            if not ESP_Boxes[player] then
               local box = Drawing.new("Square")
               box.Color = Color3.fromRGB(255, 50, 50)
               box.Thickness = 1.5
               box.Filled = false
               ESP_Boxes[player] = box
            end

            local box = ESP_Boxes[player]
            local head = player.Character:FindFirstChild("Head")
            if head then
               local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
               local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
               local height = math.abs(headPos.Y - legPos.Y)
               local width = height / 2

               box.Size = Vector2.new(width, height)
               box.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
               box.Visible = true
            end
         else
            if ESP_Boxes[player] then
               ESP_Boxes[player].Visible = false
            end
         end

         -- Tracer Line ESP
         if ESP_Tracer_Enabled and onScreen then
            if not ESP_Tracers[player] then
               local line = Drawing.new("Line")
               line.Color = Color3.fromRGB(0, 255, 150)
               line.Thickness = 1.5
               ESP_Tracers[player] = line
            end

            local line = ESP_Tracers[player]
            line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            line.To = Vector2.new(vector.X, vector.Y)
            line.Visible = true
         else
            if ESP_Tracers[player] then
               ESP_Tracers[player].Visible = false
            end
         end
      else
         RemoveESP(player)
      end
   end
end)

