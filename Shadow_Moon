-- ==========================================
-- ESP LOGIC
-- ==========================================
local function ClearESP(plr)
    if ESPObjects[plr] then
        for _, obj in pairs(ESPObjects[plr]) do
            if typeof(obj) == "Instance" then obj:Destroy() end
        end
        ESPObjects[plr] = nil
    end
    if Tracers[plr] then
        Tracers[plr]:Remove()
        Tracers[plr] = nil
    end
    if NameTags[plr] then
        NameTags[plr]:Remove()
        NameTags[plr] = nil
    end
end

local function UpdateESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            ClearESP(plr)
            
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0 and not IsSameTeam(plr) then
                ESPObjects[plr] = {}

                if ESPMode == "Highlight" then
                    local highlight = Instance.new("Highlight")
                    highlight.Parent = plr.Character
                    highlight.FillColor = ESPColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    table.insert(ESPObjects[plr], highlight)

                elseif ESPMode == "Box" then
                    local box = Instance.new("SelectionBox")
                    box.Adornee = plr.Character
                    box.Color3 = ESPColor
                    box.LineThickness = 0.05
                    box.Parent = plr.Character
                    table.insert(ESPObjects[plr], box)
                end

                if TracersEnabled then
                    local line = Drawing.new("Line")
                    line.Color = ESPColor
                    line.Thickness = 1.5
                    Tracers[plr] = line
                end

                if NameESPEnabled then
                    local text = Drawing.new("Text")
                    text.Color = Color3.fromRGB(255, 255, 255)
                    text.Size = 16
                    text.Center = true
                    text.Outline = true
                    NameTags[plr] = text
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    for plr, line in pairs(Tracers) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
            if OnScreen then
                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                line.To = Vector2.new(ScreenPos.X, ScreenPos.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end

    for plr, text in pairs(NameTags) do
        if plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local HeadPos = plr.Character.Head.Position + Vector3.new(0, 2, 0)
            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(HeadPos)
            if OnScreen then
                text.Position = Vector2.new(ScreenPos.X, ScreenPos.Y)
                text.Text = plr.Name .. " [" .. math.floor(plr.Character.Humanoid.Health) .. " HP]"
                text.Visible = true
            else
                text.Visible = false
            end
        else
            text.Visible = false
        end
    end
end)

