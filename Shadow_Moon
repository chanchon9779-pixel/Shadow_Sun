-- ==========================================
-- HELPER FUNCTIONS
-- ==========================================
local function IsSameTeam(player)
    if TeamCheck and LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end
    return false
end

local function GetClosestTarget()
    local ClosestPlayer = nil
    local MaxDistance = FOVRadius

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and not IsSameTeam(v) and v.Character and v.Character:FindFirstChild(AimPart) and v.Character:FindFirstChildOfClass("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(v.Character[AimPart].Position)
                if OnScreen then
                    local MousePos = Vector2.new(Mouse.X, Mouse.Y)
                    local TargetPos = Vector2.new(ScreenPos.X, ScreenPos.Y)
                    local Distance = (MousePos - TargetPos).Magnitude

                    if Distance < MaxDistance then
                        if not WallbangEnabled then
                            local RayParams = RaycastParams.new()
                            RayParams.FilterType = Enum.RaycastFilterType.Exclude
                            RayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                            
                            local Result = Workspace:Raycast(Camera.CFrame.Position, (v.Character[AimPart].Position - Camera.CFrame.Position), RayParams)
                            if Result and Result.Instance:IsDescendantOf(v.Character) then
                                MaxDistance = Distance
                                ClosestPlayer = v
                            end
                        else
                            MaxDistance = Distance
                            ClosestPlayer = v
                        end
                    end
                end
            end
        end
    end
    return ClosestPlayer
end

local function GetPlayerList()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    if #list == 0 then table.insert(list, "ไม่พบผู้เล่นอื่น") end
    return list
end

